# Required only for AI-generated Q&A responses.
GROQ_API_KEY=your_groq_api_key_here

# Optional: keep tokens valid across API restarts. If you set this, use a
# random value of at least 32 characters. Leave commented for a per-run secret.
# AUTOARCH_API_SECRET=

# Optional: the default database is data/processed/access_control.sqlite3.
# AUTOARCH_DB_PATH=

# Optional: set this only if Tesseract is installed but not available on PATH.
# TESSERACT_CMD=
